#!/usr/bin/env bash
# pre-push hook with failure recording (cmd_1117)
# semantic-links: [[忍者報告品質プロトコル]]
#
# Non-zero exitで logs/hook_failures.yaml に自動記録。
# 記録部分は || true で防御（記録エラーでhookの動作を阻害しない）。

_HOOK_DIR="$(cd "$(dirname "$0")" && pwd)"
if [ "$(basename "$_HOOK_DIR")" = ".githooks" ]; then
    # Tracked source invoked directly (tests/manual verification).
    REPO_ROOT="$(cd "$_HOOK_DIR/.." && pwd)"
else
    # Installed copy under .git/hooks.
    REPO_ROOT="$(cd "$_HOOK_DIR/../.." && pwd)"
fi
_STDERR_FILE="/tmp/_hook_stderr_prepush_$$"
_HOOK_ARTIFACT_DIR="$REPO_ROOT/logs/hook_artifacts"
_HOOK_ARTIFACT_ID="$(date +%Y%m%dT%H%M%S)_pre-push_$$"
_HOOK_ARTIFACT_FILE="$_HOOK_ARTIFACT_DIR/${_HOOK_ARTIFACT_ID}.log"
_HOOK_STARTED_AT="$(date -Iseconds)"
_HOOK_SHA256="$(sha256sum "$0" 2>/dev/null | awk '{print $1}')"
_CHANGED_FILES_FILE="/tmp/_hook_changed_files_prepush_$$"
_SELECTED_TESTS_FILE="/tmp/_hook_selected_tests_prepush_$$"
_BATS_OUTPUT_FILE="/tmp/_hook_bats_output_prepush_$$"
_PREPUSH_LOCK_FILE="$REPO_ROOT/logs/prepush_test.lock"
_PREPUSH_PASS_CACHE="$REPO_ROOT/logs/prepush_test_pass.sha"

for _arg in "$@"; do
    if [ "$_arg" = "--force" ] || [ "$_arg" = "-f" ]; then
        echo "git push --force is forbidden; use --force-with-lease when history rewrite is intentional."
        echo "git push --force is forbidden; use --force-with-lease when history rewrite is intentional." >&2
        exit 1
    fi
done
_parent_args="$(ps -o args= -p "$PPID" 2>/dev/null || true)"
if [[ " $_parent_args " == *" --force "* || " $_parent_args " == *" -f "* ]]; then
    echo "git push --force is forbidden; use --force-with-lease when history rewrite is intentional."
    echo "git push --force is forbidden; use --force-with-lease when history rewrite is intentional." >&2
    exit 1
fi

# --- Failure recording trap (cmd_1117) ---
_record_hook_failure() {
    local exit_code=$1
    if [ "$exit_code" -ne 0 ]; then
        (
            ninja_name=$(tmux display-message -t "$TMUX_PANE" -p '#{@agent_id}' 2>/dev/null || echo "unknown")
            stderr_summary=""
            [ -s "$_STDERR_FILE" ] && stderr_summary=$(head -c 800 "$_STDERR_FILE" 2>/dev/null | tr '\n' ' ' | tr '"' "'")
            mkdir -p "$REPO_ROOT/logs" "$_HOOK_ARTIFACT_DIR"
            {
                echo "# pre-push hook failure artifact"
                echo "timestamp: $_HOOK_STARTED_AT"
                echo "hook_sha256: $_HOOK_SHA256"
                echo "exit_code: $exit_code"
                echo
                echo "## changed_files"
                if [ -s "$_CHANGED_FILES_FILE" ]; then
                    cat "$_CHANGED_FILES_FILE"
                else
                    echo "(none captured)"
                fi
                echo
                echo "## selected_tests"
                if [ -s "$_SELECTED_TESTS_FILE" ]; then
                    cat "$_SELECTED_TESTS_FILE"
                else
                    echo "(none captured)"
                fi
                echo
                echo "## bats_output"
                if [ -s "$_BATS_OUTPUT_FILE" ]; then
                    cat "$_BATS_OUTPUT_FILE"
                else
                    echo "(empty)"
                fi
                echo
                echo "## stderr"
                if [ -s "$_STDERR_FILE" ]; then
                    cat "$_STDERR_FILE"
                else
                    echo "(empty)"
                fi
            } > "$_HOOK_ARTIFACT_FILE"
            echo "- timestamp: $(date -Iseconds)" >> "$REPO_ROOT/logs/hook_failures.yaml"
            echo "  hook: pre-push" >> "$REPO_ROOT/logs/hook_failures.yaml"
            echo "  ninja: $ninja_name" >> "$REPO_ROOT/logs/hook_failures.yaml"
            echo "  exit_code: $exit_code" >> "$REPO_ROOT/logs/hook_failures.yaml"
            echo "  artifact: \"logs/hook_artifacts/${_HOOK_ARTIFACT_ID}.log\"" >> "$REPO_ROOT/logs/hook_failures.yaml"
            echo "  started_at: \"$_HOOK_STARTED_AT\"" >> "$REPO_ROOT/logs/hook_failures.yaml"
            echo "  hook_sha256: \"$_HOOK_SHA256\"" >> "$REPO_ROOT/logs/hook_failures.yaml"
            echo "  detail: \"$stderr_summary\"" >> "$REPO_ROOT/logs/hook_failures.yaml"
        ) || true
        # 判定根拠の可視化(LS078): stderrはartifactへ隔離されるため、失敗理由の要点を
        # stdout経由で実行者へ即表示する。無言exit 1は原因調査を毎回ゼロからにする(2026-07-02実害3回)
        {
            echo "[pre-push] BLOCK (exit ${exit_code})"
            [ -s "$_BATS_OUTPUT_FILE" ] && grep -E "^not ok|^# " "$_BATS_OUTPUT_FILE" 2>/dev/null | head -5
            echo "[pre-push] 詳細: logs/hook_artifacts/${_HOOK_ARTIFACT_ID}.log"
        } 2>/dev/null || true
    fi
    rm -f "$_STDERR_FILE" 2>/dev/null
    rm -f "$_CHANGED_FILES_FILE" "$_SELECTED_TESTS_FILE" "$_BATS_OUTPUT_FILE" 2>/dev/null
}
trap '_ec=$?; _record_hook_failure $_ec; exit $_ec' EXIT

# Capture stderr for failure recording without a tee subprocess.
exec 2>"$_STDERR_FILE"

# A push from karo and an automated retry can arrive seconds apart.  Running two
# full suites against the same WSL checkout multiplies I/O contention and has
# repeatedly made both otherwise healthy runs hit the 900s timeout (GA-270).
# Serialize the test lane, then let a follower reuse a PASS for the exact same
# commit.  A changed commit never reuses the cache, and failures are not cached.
mkdir -p "$REPO_ROOT/logs"
exec 9>"$_PREPUSH_LOCK_FILE"
if ! flock -w 1200 9; then
    echo "[pre-push] BLOCK: timed out waiting for the serialized test lane." >&2
    exit 1
fi
_PREPUSH_SHA="$(git rev-parse HEAD 2>/dev/null || true)"
_PREPUSH_CACHE_HIT=0
if [ -n "$_PREPUSH_SHA" ] && [ -r "$_PREPUSH_PASS_CACHE" ] \
        && [ "$(cat "$_PREPUSH_PASS_CACHE" 2>/dev/null)" = "$_PREPUSH_SHA" ]; then
    _PREPUSH_CACHE_HIT=1
    echo "[pre-push] Reusing serialized PASS for $_PREPUSH_SHA."
    echo "[pre-push] Reusing serialized PASS for $_PREPUSH_SHA." >&2
fi

# ============================================
# Pre-push checks (add checks below this line)
# ============================================

# --- test_select: 変更ファイルに対応するbatsテストを選択実行 (cmd_2105) ---
# タイムアウト60秒。未知ファイルのみの変更時はWARN+スキップ。
_PUSH_REFS=()
while IFS= read -r _ref_line; do
    _PUSH_REFS+=("$_ref_line")
done

_changed_files=()
for _ref_line in "${_PUSH_REFS[@]}"; do
    read -r _local_ref _local_sha _remote_ref _remote_sha <<< "$_ref_line"
    # 削除push (local sha = 0) はスキップ
    [ "$_local_sha" = "0000000000000000000000000000000000000000" ] && continue
    if [ "$_remote_sha" = "0000000000000000000000000000000000000000" ]; then
        # 新規ブランチ: main との merge-base を使用
        _base_sha=$(git merge-base HEAD origin/main 2>/dev/null \
                    || git rev-list --max-parents=0 HEAD 2>/dev/null \
                    || echo "")
    else
        _base_sha="$_remote_sha"
    fi
    if [ -n "$_base_sha" ]; then
        while IFS= read -r _f; do
            [ -n "$_f" ] && _changed_files+=("$_f")
        done < <(git diff --name-only "$_base_sha" "$_local_sha" 2>/dev/null || true)
    fi
done

if [ "$_PREPUSH_CACHE_HIT" -eq 0 ] && [ ${#_changed_files[@]} -gt 0 ]; then
    # dedup
    mapfile -t _changed_files < <(printf '%s\n' "${_changed_files[@]}" | sort -u)
    printf '%s\n' "${_changed_files[@]}" > "$_CHANGED_FILES_FILE"

    # test_select.sh で影響テストを選択 (stdout=テストファイルパス, stderr=WARNs→ターミナル表示)
    _selected_tests=$(bash "$REPO_ROOT/scripts/test_select.sh" "${_changed_files[@]}") || true
    [ -n "$_selected_tests" ] && printf '%s\n' "$_selected_tests" > "$_SELECTED_TESTS_FILE"

    if [ -n "$_selected_tests" ]; then
        echo "[pre-push] Running selected tests (timeout 60s)..." >&2
        set +e
        timeout 60 env BATS_CACHE=0 BATS_INNER_JOBS=1 \
            bash "$REPO_ROOT/scripts/run_tests.sh" affected "${_changed_files[@]}" \
            > "$_BATS_OUTPUT_FILE" 2>&1
        _rc=$?
        set -e
        cat "$_BATS_OUTPUT_FILE" >&2
        if [ "$_rc" -eq 124 ]; then
            echo "[pre-push] WARN: test_select timeout (60s) — push allowed" >&2
        elif [ "$_rc" -ne 0 ]; then
            exit "$_rc"
        fi
    fi
fi

# --- Full unit suite: CIに委任（殿裁定2026-07-16: CIとの二重チェックは構造的バグ） ---
# 全量ユニットテストはCI(GitHub Actions)が担当。pre-pushはaffected tests(L165-179)のみ。
# 旧: timeout 900s full suite → pushタイムアウトで通らない構造的障害

# --- Ontology integrity check (殿裁定2026-06-20: オントロジーは自動実行されて初めて効果が出る) ---
if [ -x "$REPO_ROOT/scripts/gates/gate_no_hardcoded_ninja_list.sh" ]; then
    echo "[pre-push] Running ontology integrity check..." >&2
    if ! timeout 15 bash "$REPO_ROOT/scripts/gates/gate_no_hardcoded_ninja_list.sh" >&2; then
        echo "[pre-push] BLOCK: ontology violation detected. Fix hardcoded agent names before pushing." >&2
        exit 1
    fi
fi

exit 0
