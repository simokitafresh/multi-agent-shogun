#!/usr/bin/env bash
# pre-push hook with failure recording (cmd_1117)
# semantic-links: [[忍者報告品質プロトコル]]
#
# Non-zero exitで logs/hook_failures.yaml に自動記録。
# 記録部分は || true で防御（記録エラーでhookの動作を阻害しない）。

_HOOK_DIR="$(cd "$(dirname "$0")" && pwd)"
# A linked worktree executes hooks from the common git dir.  Deriving the work
# tree from the hook's pathname therefore points at the primary checkout and
# lets fixture/test operations escape into it.  Git's invocation cwd is the
# authoritative worktree for both tracked and installed hook copies.
REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [ -z "$REPO_ROOT" ] || [ ! -d "$REPO_ROOT" ]; then
    echo "[pre-push] BLOCK: cannot resolve the pushing worktree." >&2
    exit 1
fi
REPO_GIT_DIR="$(git rev-parse --git-dir 2>/dev/null || true)"
REPO_COMMON_DIR="$(git rev-parse --git-common-dir 2>/dev/null || true)"
if [[ "$REPO_GIT_DIR" = /* && "$REPO_COMMON_DIR" = /* && "$REPO_GIT_DIR" != "$REPO_COMMON_DIR" ]]; then
    PRE_PUSH_WORKTREE_MODE=linked
else
    PRE_PUSH_WORKTREE_MODE=shared
fi
export PRE_PUSH_WORKTREE_MODE
echo "[pre-push] worktree_mode=$PRE_PUSH_WORKTREE_MODE repo=$REPO_ROOT" >&2

PRE_PUSH_TOTAL_T0_US="${EPOCHREALTIME/./}"
PRE_PUSH_TOTAL_T0_US="${PRE_PUSH_TOTAL_T0_US:0:16}"
DEFENSE_OVERHEAD_REPO_ROOT="${DEFENSE_OVERHEAD_REPO_ROOT:-$REPO_ROOT}"
if [ -f "$REPO_ROOT/scripts/lib/defense_overhead_writer.sh" ]; then
    # shellcheck source=scripts/lib/defense_overhead_writer.sh
    source "$REPO_ROOT/scripts/lib/defense_overhead_writer.sh"
else
    defense_overhead_write_async() { return 0; }
fi
PRE_PUSH_TOTAL_RECORDED=0
pre_push_record_total() {
    local rc="${1:-0}" now_us wall_ms verdict
    [ "${PRE_PUSH_TOTAL_RECORDED:-0}" -eq 0 ] || return 0
    PRE_PUSH_TOTAL_RECORDED=1
    now_us="${EPOCHREALTIME/./}"
    now_us="${now_us:0:16}"
    wall_ms=$(( (now_us - PRE_PUSH_TOTAL_T0_US + 999) / 1000 ))
    verdict=PASS
    [ "$rc" -eq 0 ] || verdict=FAIL
    defense_overhead_write_async pre_push pre_push_total "$wall_ms" "$verdict" \
        "pre-push-${BASHPID}-${PRE_PUSH_TOTAL_T0_US}" || true
}
pre_push_total_on_exit() { local rc=$?; pre_push_record_total "$rc"; return "$rc"; }
trap pre_push_total_on_exit EXIT

if [ -f "$REPO_ROOT/scripts/lib/autogen_paths.sh" ]; then
    # shellcheck source=scripts/lib/autogen_paths.sh
    source "$REPO_ROOT/scripts/lib/autogen_paths.sh"
fi
# Git exports repository-local variables to hooks.  If they leak into Bats,
# fixture commands such as `git -C "$tmpdir" init/commit` still operate on the
# push repository and can commit/delete its real files.  Resolve REPO_ROOT
# first, then clear the local environment before invoking any child Git repo.
_GIT_LOCAL_ENV_VARS="$(git rev-parse --local-env-vars 2>/dev/null || true)"
if [ -n "$_GIT_LOCAL_ENV_VARS" ]; then
    # shellcheck disable=SC2086 # variable names are emitted by git itself
    unset $_GIT_LOCAL_ENV_VARS
fi
unset _GIT_LOCAL_ENV_VARS
_STDERR_FILE="/tmp/_hook_stderr_prepush_$$"
_HOOK_ARTIFACT_DIR="$REPO_ROOT/logs/hook_artifacts"
_HOOK_ARTIFACT_ID="$(date +%Y%m%dT%H%M%S)_pre-push_$$"
_HOOK_ARTIFACT_FILE="$_HOOK_ARTIFACT_DIR/${_HOOK_ARTIFACT_ID}.log"
_HOOK_STARTED_AT="$(date -Iseconds)"
_HOOK_SHA256="$(sha256sum "$0" 2>/dev/null | awk '{print $1}')"
_CHANGED_FILES_FILE="/tmp/_hook_changed_files_prepush_$$"
_SELECTED_TESTS_FILE="/tmp/_hook_selected_tests_prepush_$$"
_BATS_OUTPUT_FILE="/tmp/_hook_bats_output_prepush_$$"
_PREPUSH_LOCK_FILE="$REPO_ROOT/logs/prepush_test.lock"
_PREPUSH_PASS_CACHE="$REPO_ROOT/logs/prepush_test_pass.sha"
_PREPUSH_LOCK_META="$REPO_ROOT/logs/prepush_test.lock.holder"
_PREPUSH_LOCK_WAIT_SECONDS="${PREPUSH_LOCK_WAIT_SECONDS:-1200}"
_PREPUSH_CROSS_GENERATION_WAIT_SECONDS="${PREPUSH_CROSS_GENERATION_WAIT_SECONDS:-1200}"
_PREPUSH_SELECTED_TEST_TIMEOUT_SECONDS="${PREPUSH_SELECTED_TEST_TIMEOUT_SECONDS:-60}"
_PREPUSH_SELECTED_TEST_KILL_AFTER_SECONDS="${PREPUSH_SELECTED_TEST_KILL_AFTER_SECONDS:-5}"
_PREPUSH_LOCK_OWNED=0
_PREPUSH_EXEC_ROOT=""
_PREPUSH_CACHE_TO_PUBLISH=""

# The affected-test lane is determined by executable sources, test contracts,
# and hook implementations.  Operational publications (insights/context/docs)
# advance HEAD without changing that lane, so HEAD itself is not a valid cache
# identity.  Hash Git's committed tree/blob records for the same target roots;
# this stays deterministic across worktrees and invalidates on any relevant
# content, mode, addition, deletion, or rename.
pre_push_test_tree_fingerprint() {
    local commit="$1"
    git -C "$REPO_ROOT" ls-tree -r --full-tree "$commit" -- \
        scripts lib tests .githooks .claude/hooks 2>/dev/null \
        | LC_ALL=C sort \
        | sha256sum \
        | awk '{print $1}'
}

for _arg in "$@"; do
    if [ "$_arg" = "--force" ] || [ "$_arg" = "-f" ]; then
        echo "git push --force is forbidden; use --force-with-lease when history rewrite is intentional."
        echo "git push --force is forbidden; use --force-with-lease when history rewrite is intentional." >&2
        exit 1
    fi
done
_parent_args="$(ps -o args= -p "$PPID" 2>/dev/null || true)"
if [[ " $_parent_args " == *" --force "* || " $_parent_args " == *" -f "* ]]; then
    echo "git push --force is forbidden; use --force-with-lease when history rewrite is intentional."
    echo "git push --force is forbidden; use --force-with-lease when history rewrite is intentional." >&2
    exit 1
fi

# --- Failure recording trap (cmd_1117) ---
_record_hook_failure() {
    local exit_code=$1
    if [ "$exit_code" -ne 0 ]; then
        (
            ninja_name=$(tmux display-message -t "$TMUX_PANE" -p '#{@agent_id}' 2>/dev/null || echo "unknown")
            stderr_summary=""
            [ -s "$_STDERR_FILE" ] && stderr_summary=$(head -c 800 "$_STDERR_FILE" 2>/dev/null | tr '\n' ' ' | tr '"' "'")
            mkdir -p "$REPO_ROOT/logs" "$_HOOK_ARTIFACT_DIR"
            {
                echo "# pre-push hook failure artifact"
                echo "timestamp: $_HOOK_STARTED_AT"
                echo "hook_sha256: $_HOOK_SHA256"
                echo "exit_code: $exit_code"
                echo
                echo "## changed_files"
                if [ -s "$_CHANGED_FILES_FILE" ]; then
                    cat "$_CHANGED_FILES_FILE"
                else
                    echo "(none captured)"
                fi
                echo
                echo "## selected_tests"
                if [ -s "$_SELECTED_TESTS_FILE" ]; then
                    cat "$_SELECTED_TESTS_FILE"
                else
                    echo "(none captured)"
                fi
                echo
                echo "## bats_output"
                if [ -s "$_BATS_OUTPUT_FILE" ]; then
                    cat "$_BATS_OUTPUT_FILE"
                else
                    echo "(empty)"
                fi
                echo
                echo "## stderr"
                if [ -s "$_STDERR_FILE" ]; then
                    cat "$_STDERR_FILE"
                else
                    echo "(empty)"
                fi
            } > "$_HOOK_ARTIFACT_FILE"
            echo "- timestamp: $(date -Iseconds)" >> "$REPO_ROOT/logs/hook_failures.yaml"
            echo "  hook: pre-push" >> "$REPO_ROOT/logs/hook_failures.yaml"
            echo "  ninja: $ninja_name" >> "$REPO_ROOT/logs/hook_failures.yaml"
            echo "  exit_code: $exit_code" >> "$REPO_ROOT/logs/hook_failures.yaml"
            echo "  artifact: \"logs/hook_artifacts/${_HOOK_ARTIFACT_ID}.log\"" >> "$REPO_ROOT/logs/hook_failures.yaml"
            echo "  started_at: \"$_HOOK_STARTED_AT\"" >> "$REPO_ROOT/logs/hook_failures.yaml"
            echo "  hook_sha256: \"$_HOOK_SHA256\"" >> "$REPO_ROOT/logs/hook_failures.yaml"
            echo "  detail: \"$stderr_summary\"" >> "$REPO_ROOT/logs/hook_failures.yaml"
        ) || true
        # 判定根拠の可視化(LS078): stderrはartifactへ隔離されるため、失敗理由の要点を
        # stdout経由で実行者へ即表示する。無言exit 1は原因調査を毎回ゼロからにする(2026-07-02実害3回)
        {
            echo "[pre-push] BLOCK (exit ${exit_code})"
            [ -s "$_BATS_OUTPUT_FILE" ] && grep -E "^not ok|^# " "$_BATS_OUTPUT_FILE" 2>/dev/null | head -5
            echo "[pre-push] 詳細: logs/hook_artifacts/${_HOOK_ARTIFACT_ID}.log"
        } 2>/dev/null || true
    fi
    rm -f "$_STDERR_FILE" 2>/dev/null
    rm -f "$_CHANGED_FILES_FILE" "$_SELECTED_TESTS_FILE" "$_BATS_OUTPUT_FILE" 2>/dev/null
    if [ -n "$_PREPUSH_EXEC_ROOT" ]; then
        git -C "$REPO_ROOT" worktree remove --force "$_PREPUSH_EXEC_ROOT" >/dev/null 2>&1 || true
        _PREPUSH_EXEC_ROOT=""
    fi
    if [ "$_PREPUSH_LOCK_OWNED" -eq 1 ] && [ -r "$_PREPUSH_LOCK_META" ] \
            && grep -qx "pid=$$" "$_PREPUSH_LOCK_META" 2>/dev/null; then
        rm -f "$_PREPUSH_LOCK_META" 2>/dev/null
    fi
}
trap '_ec=$?; _record_hook_failure $_ec; pre_push_record_total "$_ec"; exit "$_ec"' EXIT

# Capture stderr for failure recording without a tee subprocess.
exec 2>"$_STDERR_FILE"

# A push from karo and an automated retry can arrive seconds apart.  Running two
# full suites against the same WSL checkout multiplies I/O contention and has
# repeatedly made both otherwise healthy runs hit the 900s timeout (GA-270).
# Serialize the test lane, then let a follower reuse a PASS for the exact same
# commit.  A changed commit never reuses the cache, and failures are not cached.
mkdir -p "$REPO_ROOT/logs"
exec 9>"$_PREPUSH_LOCK_FILE"
if ! flock -w "$_PREPUSH_LOCK_WAIT_SECONDS" 9; then
    _holder_pid="$(awk -F= '$1=="pid"{print $2}' "$_PREPUSH_LOCK_META" 2>/dev/null)"
    _holder_started="$(awk -F= '$1=="started_at"{sub(/^[^=]*=/,""); print}' "$_PREPUSH_LOCK_META" 2>/dev/null)"
    _holder_sha="$(awk -F= '$1=="hook_sha256"{print $2}' "$_PREPUSH_LOCK_META" 2>/dev/null)"
    _holder_identity="pid=${_holder_pid:-unknown} started_at=${_holder_started:-unknown} hook_sha256=${_holder_sha:-unknown}"
    if ! [[ "$_holder_pid" =~ ^[0-9]+$ ]] || ! kill -0 "$_holder_pid" 2>/dev/null \
            || [ -z "$_holder_started" ] || [ -z "$_holder_sha" ]; then
        echo "[pre-push] BLOCK: stale/abnormal serialized test lane holder (${_holder_identity})."
        echo "[pre-push] BLOCK: stale/abnormal serialized test lane holder (${_holder_identity})." >&2
        exit 1
    fi
    if [ "$_holder_sha" = "$_HOOK_SHA256" ]; then
        echo "[pre-push] BLOCK: timed out waiting for same-generation serialized test lane (${_holder_identity})."
        echo "[pre-push] BLOCK: timed out waiting for same-generation serialized test lane (${_holder_identity})." >&2
        exit 1
    fi
    echo "[pre-push] Superseded holder still active; waiting for safe handoff (${_holder_identity})."
    echo "[pre-push] Superseded holder still active; waiting for safe handoff (${_holder_identity})." >&2
    if ! flock -w "$_PREPUSH_CROSS_GENERATION_WAIT_SECONDS" 9; then
        echo "[pre-push] BLOCK: cross-generation handoff timed out (${_holder_identity})." >&2
        exit 1
    fi
fi
_PREPUSH_LOCK_OWNED=1
_meta_tmp="${_PREPUSH_LOCK_META}.$$"
{
    echo "pid=$$"
    echo "started_at=$_HOOK_STARTED_AT"
    echo "hook_sha256=$_HOOK_SHA256"
} > "$_meta_tmp"
mv -f "$_meta_tmp" "$_PREPUSH_LOCK_META"
_PREPUSH_CACHE_HIT=0

# ============================================
# Pre-push checks (add checks below this line)
# ============================================

# --- test_select: 変更ファイルに対応するbatsテストを選択実行 (cmd_2105) ---
# タイムアウト60秒。未知ファイルのみの変更時はWARN+スキップ。
pre_push_runtime_only_path() {
    local path="$1"
    case "$path" in
        context/*.md|projects/*/lessons.yaml|projects/*/lessons.yml|tasks/lessons.md|dashboard.md)
            return 0
            ;;
        queue/*.yaml|queue/*.yml|queue/*.json|queue/*.jsonl|queue/*.md|queue/*.txt)
            return 0
            ;;
        queue/*/*.yaml|queue/*/*.yml|queue/*/*.json|queue/*/*.jsonl|queue/*/*.md|queue/*/*.txt)
            return 0
            ;;
        logs/*.yaml|logs/*.yml|logs/*.json|logs/*.jsonl|logs/*.md|logs/*.txt)
            return 0
            ;;
        logs/*/*.yaml|logs/*/*.yml|logs/*/*.json|logs/*/*.jsonl|logs/*/*.md|logs/*/*.txt)
            return 0
            ;;
        *)
            return 1
            ;;
    esac
}

pre_push_runtime_only_commit() {
    local path
    [ "$#" -gt 0 ] || return 1
    for path in "$@"; do
        # This is deliberately fail-closed: one code, hook, test, or unknown
        # path keeps the affected-test lane active for the whole commit.
        pre_push_runtime_only_path "$path" || return 1
    done
    return 0
}

_PUSH_REFS=()
while IFS= read -r _ref_line; do
    _PUSH_REFS+=("$_ref_line")
done

for _ref_line in "${_PUSH_REFS[@]}"; do
    read -r _local_ref _local_sha _remote_ref _remote_sha <<< "$_ref_line"
    # 削除push (local sha = 0) はスキップ
    [ "$_local_sha" = "0000000000000000000000000000000000000000" ] && continue
    _PREPUSH_CACHE_HIT=0
    _PREPUSH_TEST_FINGERPRINT="$(pre_push_test_tree_fingerprint "$_local_sha")"
    if ! [[ "$_PREPUSH_TEST_FINGERPRINT" =~ ^[0-9a-f]{64}$ ]]; then
        echo "[pre-push] BLOCK: cannot compute affected-test tree fingerprint for $_local_sha." >&2
        exit 1
    fi
    if [ -r "$_PREPUSH_PASS_CACHE" ] \
            && [ "$(cat "$_PREPUSH_PASS_CACHE" 2>/dev/null)" = "$_PREPUSH_TEST_FINGERPRINT" ]; then
        _PREPUSH_CACHE_HIT=1
        echo "[pre-push] Reusing serialized PASS for affected-test tree $_PREPUSH_TEST_FINGERPRINT." >&2
    fi
    if [ "$_remote_sha" = "0000000000000000000000000000000000000000" ]; then
        # 新規ブランチ: main との merge-base を使用
        _base_sha=$(git merge-base "$_local_sha" origin/main 2>/dev/null \
                    || git rev-list --max-parents=0 "$_local_sha" 2>/dev/null \
                    || echo "")
    else
        _base_sha="$_remote_sha"
    fi
    [ -z "$_base_sha" ] && continue
    # Disable rename detection so a source-to-runtime rename exposes both
    # endpoints and cannot be misclassified as runtime-only.
    mapfile -t _changed_files < <(git diff --no-renames --name-only "$_base_sha" "$_local_sha" 2>/dev/null | sort -u)
    if [ "$_PREPUSH_CACHE_HIT" -eq 1 ] || [ ${#_changed_files[@]} -eq 0 ]; then
        continue
    fi
    printf '%s\n' "${_changed_files[@]}" > "$_CHANGED_FILES_FILE"

    # --- Dirty working tree / pushed-commit overlap guard ---
    # (cmd_karo_impl_commander_scope_commit_20260725 AC2)
    # 実害: 家老のpushが才蔵の未commit変更(参照整理)を置き去りにして公開し、
    # CI setup_fileがRED化した(公開済みcommitと作業ツリーの未確定状態が不整合を
    # 起こした)。pushしようとしているcommitが変更したpathと、現在の作業ツリーに
    # 残る未commit変更(他者所有含む)のpathが重なる場合、公開される内容が
    # 作業ツリー上でまだ確定していない変更と食い違っている可能性が高い。
    # デフォルトでBLOCKする。判定は状態のみに依存するため再試行しても同じ結果になる。
    # AC4: 緊急D0 hotfixの摩擦を減らすため明示的escape hatchを用意し、
    # 使用時はlogs/push_dirty_tree_bypass.jsonlへ理由付きで記録する(計測可能)。
    if [ -z "${SHOGUN_PUSH_DIRTY_TREE_BYPASS:-}" ]; then
        mapfile -t _dirty_paths < <(git -C "$REPO_ROOT" status --porcelain --untracked-files=no 2>/dev/null | cut -c4- | sort -u)
        if [ "${#_dirty_paths[@]}" -gt 0 ]; then
            _overlap_paths=""
            for _dp in "${_dirty_paths[@]}"; do
                for _cf in "${_changed_files[@]}"; do
                    if [ "$_dp" = "$_cf" ]; then
                        _overlap_paths="${_overlap_paths}${_dp}"$'\n'
                    fi
                done
            done
            if [ -n "$_overlap_paths" ]; then
                # 自動生成path(context索引・queue/logs運用ファイル等)は、内容が
                # 同一でも再生成のたびにdiffが出る(cmd_karo_impl_prepush_autogen_exclude_20260726:
                # conversation_retention.shがgenerated_atを毎回nowで更新するため)。
                # 除外根拠は「自動生成であること」であり、通常ファイルの重複は
                # 従来通りBLOCKする(自動生成pathと混在していてもBLOCKする)。
                _overlap_paths_blocking="$_overlap_paths"
                if [ -n "${AUTOGEN_PATH_EXCLUDE_REGEX:-}" ]; then
                    _overlap_paths_blocking=$(printf '%s\n' "$_overlap_paths" | sed '/^$/d' | grep -v -E "$AUTOGEN_PATH_EXCLUDE_REGEX" || true)
                fi
                if [ -n "$_overlap_paths_blocking" ]; then
                    echo "[pre-push] BLOCK(GA-PUSH1): pushしようとしているcommitと、作業ツリーの未commit変更が同一pathを差している。" >&2
                    echo "[pre-push] 公開されるcommitの内容が、作業ツリー上でまだ未確定の変更と不整合を起こす可能性がある。" >&2
                    echo "[pre-push] 重複path:" >&2
                    printf '%s\n' "$_overlap_paths_blocking" | sed '/^$/d' | sed 's/^/  /' >&2
                    echo "[pre-push] 対処: 未commit変更をcommitしてから再push、または他者の変更なら内容を確認せよ。" >&2
                    echo "[pre-push] 緊急時のescape hatch: SHOGUN_PUSH_DIRTY_TREE_BYPASS='<理由>' git push" >&2
                    echo "[pre-push]   (使用はlogs/push_dirty_tree_bypass.jsonlへ理由付きで記録され、計測可能)" >&2
                    exit 1
                fi
                echo "[pre-push] INFO(GA-PUSH1): 重複pathは自動生成/運用ファイルのみのためBLOCKをskipする:" >&2
                printf '%s\n' "$_overlap_paths" | sed '/^$/d' | sed 's/^/  /' >&2
            fi
        fi
    else
        mkdir -p "$REPO_ROOT/logs"
        SHOGUN_PUSH_DIRTY_TREE_BYPASS="$SHOGUN_PUSH_DIRTY_TREE_BYPASS" \
        TMUX_AGENT_ID="${TMUX_AGENT_ID:-}" \
        python3 - "$REPO_ROOT/logs/push_dirty_tree_bypass.jsonl" <<'PY' 2>/dev/null || true
import json, os, sys, datetime
path = sys.argv[1]
entry = {
    "timestamp": datetime.datetime.now(datetime.timezone.utc).isoformat(),
    "reason": os.environ.get("SHOGUN_PUSH_DIRTY_TREE_BYPASS", ""),
    "agent": os.environ.get("TMUX_AGENT_ID") or "unknown",
}
with open(path, "a", encoding="utf-8") as fh:
    fh.write(json.dumps(entry, ensure_ascii=False) + "\n")
PY
                echo "[pre-push] WARN(GA-PUSH1): dirty working tree bypass used (SHOGUN_PUSH_DIRTY_TREE_BYPASS set). Logged to logs/push_dirty_tree_bypass.jsonl" >&2
    fi

    # Runtime publication commits update only operational records/documents.
    # Their context/lessons mappings otherwise select the same affected-test
    # lane repeatedly, even though no executable source changed.  The
    # classifier consumes paths from the pushed commit snapshot above, not the
    # working tree.  It is an allowlist and therefore preserves fail-closed
    # behavior for any source, hook, test, or unknown path mixed into a commit.
    if pre_push_runtime_only_commit "${_changed_files[@]}"; then
        echo "[pre-push] runtime-only source commit: skip affected tests (changed_files=${#_changed_files[@]})" >&2
        continue
    fi

    _PREPUSH_EXEC_ROOT="$(mktemp -d "${TMPDIR:-/tmp}/shogun-prepush.XXXXXX")"
    # /tmp(ext4)側worktreeは/mnt/c(DRVFS)本体とowner混在扱いになり
    # 'dubious ownership'でcheckoutが落ちる(2026-07-24 GA-325-328根因。
    # dirty filesは無関係)。作成中だけsafe.directoryへ登録する
    git config --global --add safe.directory "$_PREPUSH_EXEC_ROOT" 2>/dev/null || true
    if ! git -C "$REPO_ROOT" worktree add --detach --no-checkout "$_PREPUSH_EXEC_ROOT" "$_local_sha" >/dev/null 2>&1 \
            || ! git -C "$_PREPUSH_EXEC_ROOT" checkout --force "$_local_sha" >/dev/null 2>&1; then
        git config --global --unset-all safe.directory "^${_PREPUSH_EXEC_ROOT}\$" 2>/dev/null || true
        echo "[pre-push] BLOCK: cannot create clean snapshot for $_local_sha." >&2
        exit 1
    fi

    # test_select.sh で影響テストを選択 (stdout=テストファイルパス, stderr=WARNs→ターミナル表示)
    _selected_tests=$(cd "$_PREPUSH_EXEC_ROOT" && bash scripts/test_select.sh "${_changed_files[@]}") || true
    [ -n "$_selected_tests" ] && printf '%s\n' "$_selected_tests" > "$_SELECTED_TESTS_FILE"

    if [ -n "$_selected_tests" ]; then
        echo "[pre-push] Running selected tests (timeout 60s)..." >&2
        set +e
        # timeout first sends TERM to the complete test process group.  A test
        # descendant may ignore TERM and keep writing into the snapshot, so
        # wait for timeout's KILL escalation before removing the worktree.
        # Removing first races the writer: Git registration disappears while
        # an untracked artifact recreates the directory (2026-07-30 incident).
        timeout --kill-after="${_PREPUSH_SELECTED_TEST_KILL_AFTER_SECONDS}s" \
            "${_PREPUSH_SELECTED_TEST_TIMEOUT_SECONDS}s" \
            env BATS_CACHE=0 BATS_INNER_JOBS=1 RUN_TESTS_RECEIPT_DIR="$REPO_ROOT/logs/test_receipts" \
            bash -c 'cd "$1" && shift && bash scripts/run_tests.sh affected "$@"' _ \
            "$_PREPUSH_EXEC_ROOT" "${_changed_files[@]}" \
            > "$_BATS_OUTPUT_FILE" 2>&1
        _rc=$?
        set -e
        cat "$_BATS_OUTPUT_FILE" >&2
        # 124: TERMで停止したtimeout。137: TERMを無視した子孫を
        # --kill-afterがKILLし、process groupの静止完了まで待ったtimeout。
        # どちらもselected-test timeout契約上はWARNであり、次のcleanupを行う。
        if [ "$_rc" -eq 124 ] || [ "$_rc" -eq 137 ]; then
            echo "[pre-push] WARN: test_select timeout (${_PREPUSH_SELECTED_TEST_TIMEOUT_SECONDS}s) — push allowed" >&2
        elif [ "$_rc" -ne 0 ]; then
            exit "$_rc"
        fi
    fi
    git -C "$REPO_ROOT" worktree remove --force "$_PREPUSH_EXEC_ROOT" >/dev/null 2>&1 || {
        echo "[pre-push] BLOCK: clean snapshot cleanup failed: $_PREPUSH_EXEC_ROOT" >&2
        exit 1
    }
    git config --global --unset-all safe.directory "^${_PREPUSH_EXEC_ROOT}\$" 2>/dev/null || true
    _PREPUSH_EXEC_ROOT=""
    _PREPUSH_CACHE_TO_PUBLISH="$_PREPUSH_TEST_FINGERPRINT"
done

# --- Full unit suite: CIに委任（殿裁定2026-07-16: CIとの二重チェックは構造的バグ） ---
# 全量ユニットテストはCI(GitHub Actions)が担当。pre-pushはaffected tests(L165-179)のみ。
# 旧: timeout 900s full suite → pushタイムアウトで通らない構造的障害

# --- Ontology integrity check (殿裁定2026-06-20: オントロジーは自動実行されて初めて効果が出る) ---
if [ -x "$REPO_ROOT/scripts/gates/gate_no_hardcoded_ninja_list.sh" ]; then
    echo "[pre-push] Running ontology integrity check..." >&2
    if ! timeout 15 bash "$REPO_ROOT/scripts/gates/gate_no_hardcoded_ninja_list.sh" >&2; then
        echo "[pre-push] BLOCK: ontology violation detected. Fix hardcoded agent names before pushing." >&2
        exit 1
    fi
fi

# Publish only after every per-ref test and global check has passed.  The test
# lane is serialized by fd 9, and atomic rename prevents readers from seeing a
# partial fingerprint.
if [ -n "$_PREPUSH_CACHE_TO_PUBLISH" ]; then
    _cache_tmp="${_PREPUSH_PASS_CACHE}.$$"
    printf '%s\n' "$_PREPUSH_CACHE_TO_PUBLISH" > "$_cache_tmp"
    mv -f "$_cache_tmp" "$_PREPUSH_PASS_CACHE"
fi

exit 0
