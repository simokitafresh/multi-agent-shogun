# ══════════════════════════════════════════════════
# Whitelist-based .gitignore
# デフォルト全除外 → OSS公開対象のみ許可
# ══════════════════════════════════════════════════

# Step 1: 全て除外
*

# Step 2: ディレクトリの探索を許可（中身は個別に許可）
!*/

# Local runtime / sandbox artifacts
.codex-tmp/
.venv/
.claude/worktrees/

# Step 3: OSS公開対象ファイルを許可
!.gitignore
!.gitattributes
!.gitleaks.toml
!CLAUDE.md
!LICENSE
!README.md
!README_ja.md
!CONTRIBUTING.md
!SECURITY.md

# Claude Code settings (spinner verbs only, no secrets)
!.claude/
!.claude/settings.json
!.claude/hooks/
!.claude/hooks/*.sh

# Instructions (core OSS)
!instructions/
!instructions/shogun.md
!instructions/karo.md
!instructions/ashigaru.md
!instructions/ashigaru-procedures.md
!instructions/ashigaru-recon.md
!instructions/gunshi.md

# Multi-CLI: CLI-specific tool descriptions
!instructions/cli_specific/
!instructions/cli_specific/claude_tools.md
!instructions/cli_specific/codex_tools.md
!instructions/cli_specific/copilot_tools.md
!instructions/cli_specific/kimi_tools.md

# Multi-CLI: Build template parts (roles, common sections)
!instructions/roles/
!instructions/roles/*.md
!instructions/common/
!instructions/common/*.md

# Multi-CLI: Generated instruction files (built by build_instructions.sh)
!instructions/generated/
!instructions/generated/*.md

# Multi-CLI: CLI adapter library + ntfy auth
!lib/
!lib/cli_adapter.sh
!lib/ntfy_auth.sh
!lib/lord_conversation.sh
!lib/rotate_log.sh
!lib/agent_state.sh

# Multi-CLI: Codex auto-load file
!AGENTS.md
!android/app/src/main/java/com/shogun/android/util/VoiceDictionary.kt
!android/app/src/main/java/com/shogun/android/MainActivity.kt
!android/app/src/main/java/com/shogun/android/data/
!android/app/src/main/java/com/shogun/android/data/AppDatabase.kt
!android/app/src/main/java/com/shogun/android/data/GistFile.kt
!android/app/src/main/java/com/shogun/android/data/GistRepository.kt
!android/app/src/main/java/com/shogun/android/data/MemoDao.kt
!android/app/src/main/java/com/shogun/android/data/MemoEntity.kt
!android/app/src/main/java/com/shogun/android/ui/MemoScreen.kt
!android/app/src/main/java/com/shogun/android/ui/ShogunScreen.kt
!android/app/src/main/java/com/shogun/android/util/MemoSyncFormatter.kt
!android/app/src/main/java/com/shogun/android/viewmodel/MemoViewModel.kt
!android/app/src/test/java/com/shogun/android/util/MemoSyncFormatterTest.kt
!android/app/src/test/java/com/shogun/android/util/VoiceDictionaryTest.kt

# Setup and deployment scripts
!shutsujin_departure.sh
!first_setup.sh
!setup.sh
!install.bat

# Development tooling
!Makefile

# Git hooks (auto-regenerate on commit)
!.githooks/
!.githooks/pre-commit
!.githooks/pre-push
!lefthook.yml
!lefthook-local.yml

# Config (sample files only, no secrets)
!config/
!config/ntfy_auth.env.sample
!config/settings.yaml
!config/projects.yaml
!projects/infra/lessons_karo.yaml
!config/cli_profiles.yaml
!config/ninja_bashrc_safety.sh
!config/lesson_tags.yaml
!config/dashboard_template.md

# Templates
!templates/
!templates/**

# Context (knowledge files — glob: cmdで変更するファイルは全て追跡)
!context/
!context/*.md
!context/archive/
!context/archive/*.md

# Scripts (glob: スクリプト追加時にgitignore編集不要)
!scripts/
!scripts/*.sh
!scripts/*.py
!scripts/lib/
!scripts/lib/*.sh
!scripts/lib/*.py
!scripts/gates/
!scripts/gates/*.sh
!scripts/gates/*.py
!scripts/hooks/
!scripts/hooks/*.sh
!scripts/oneshot/
!scripts/oneshot/*.sh
!scripts/oneshot/*.py
!scripts/cdp/
!scripts/cdp/*.py
!scripts/cdp/*.sh
!scripts/cdp/*.md


# Archive (frozen retired components)
!archive/
!archive/frozen/
!archive/frozen/gunshi.md
!archive/frozen/gunshi_to_karo.yaml
!archive/frozen/gunshi_inbox.yaml
!archive/cmd-chronicle/
!archive/cmd-chronicle/*.md
