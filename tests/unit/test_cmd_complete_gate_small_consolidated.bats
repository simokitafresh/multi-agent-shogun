#!/usr/bin/env bats
# Generated by cmd_2894: consolidates 1-3 test files while preserving each original @test case.

run_embedded_test() {
    local original_path="$1"
    local test_name="$2"
    local content_func="$3"
    local created="false"

    if [ ! -f "$original_path" ]; then
        mkdir -p "$(dirname "$original_path")"
        "$content_func" > "$original_path"
        created="true"
    fi

    run bats --filter "^${test_name}$" "$original_path"
    if [ "$created" = "true" ]; then
        rm -f "$original_path"
    fi

    [ "$status" -eq 0 ]
}

