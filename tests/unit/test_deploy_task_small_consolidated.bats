@test 'test_deploy_task_lesson_impact_schema.bats :: deploy_task lesson_impact schema includes traversal_depth after score' {
    run_embedded_test 'tests/unit/test_deploy_task_lesson_impact_schema.bats' 'deploy_task lesson_impact schema includes traversal_depth after score' content_test_deploy_task_lesson_impact_schema
}

@test 'test_deploy_task_lesson_impact_schema.bats :: deploy_task writes direct lesson matches with traversal_depth zero' {
    run_embedded_test 'tests/unit/test_deploy_task_lesson_impact_schema.bats' 'deploy_task writes direct lesson matches with traversal_depth zero' content_test_deploy_task_lesson_impact_schema
}

@test 'test_deploy_task_lesson_impact_schema.bats :: deploy_task upgrades existing lesson_impact header before appending rows' {
    run_embedded_test 'tests/unit/test_deploy_task_lesson_impact_schema.bats' 'deploy_task upgrades existing lesson_impact header before appending rows' content_test_deploy_task_lesson_impact_schema
}

@test 'test_deploy_task_recent_noncmd_commit_warn.bats :: 軍師/家老の自走commit(cmd_を含まないmessage+24h以内)があるファイルを含むcmd配備でWARN出力される' {
    run_embedded_test 'tests/unit/test_deploy_task_recent_noncmd_commit_warn.bats' '軍師/家老の自走commit(cmd_を含まないmessage+24h以内)があるファイルを含むcmd配備でWARN出力される' content_test_deploy_task_recent_noncmd_commit_warn
}

@test 'test_deploy_task_recent_noncmd_commit_warn.bats :: 忍者のcmd commit(messageにcmd_XXXXを含む)があるファイルではWARN出力されない' {
    run_embedded_test 'tests/unit/test_deploy_task_recent_noncmd_commit_warn.bats' '忍者のcmd commit(messageにcmd_XXXXを含む)があるファイルではWARN出力されない' content_test_deploy_task_recent_noncmd_commit_warn
}

@test 'test_deploy_task_recent_noncmd_commit_warn.bats :: 24h以上前のcommitではWARN出力されない' {
    run_embedded_test 'tests/unit/test_deploy_task_recent_noncmd_commit_warn.bats' '24h以上前のcommitではWARN出力されない' content_test_deploy_task_recent_noncmd_commit_warn
}
