}

@test 'test_cmd_save_archive_dup.bats :: T-A02: different cmd in archive produces no archive WARNING' {
    run_embedded_test 'tests/unit/test_cmd_save_archive_dup.bats' 'T-A02: different cmd in archive produces no archive WARNING' content_test_cmd_save_archive_dup
}

@test 'test_cmd_save_archive_dup.bats :: T-A03: missing archive dir produces no error' {
    run_embedded_test 'tests/unit/test_cmd_save_archive_dup.bats' 'T-A03: missing archive dir produces no error' content_test_cmd_save_archive_dup
}

