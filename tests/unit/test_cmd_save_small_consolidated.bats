}

@test 'test_cmd_save_ac_absolute_literals.bats :: 0件やゼロもWARN対象に含む' {
    run_embedded_test 'tests/unit/test_cmd_save_ac_absolute_literals.bats' '0件やゼロもWARN対象に含む' content_test_cmd_save_ac_absolute_literals
}

