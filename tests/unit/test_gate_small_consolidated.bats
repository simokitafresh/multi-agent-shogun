@test 'test_gate_autofix_proposal.bats :: gate_autofix_proposal skips ninja-unread gated patterns and emits valid proposals' {
    run_embedded_test 'tests/unit/test_gate_autofix_proposal.bats' 'gate_autofix_proposal skips ninja-unread gated patterns and emits valid proposals' content_test_gate_autofix_proposal
}

@test 'test_gate_autofix_proposal.bats :: gate_autofix_proposal does not propose gate_report_format handled patterns' {
    run_embedded_test 'tests/unit/test_gate_autofix_proposal.bats' 'gate_autofix_proposal does not propose gate_report_format handled patterns' content_test_gate_autofix_proposal
}

@test 'test_gate_autofix_proposal.bats :: gate_autofix_proposal uses only the most recent 50 BLOCK rows' {
    run_embedded_test 'tests/unit/test_gate_autofix_proposal.bats' 'gate_autofix_proposal uses only the most recent 50 BLOCK rows' content_test_gate_autofix_proposal
}

@test 'test_gate_fp_relaxation_proposal.bats :: escalated_to_block WARN is treated as TP, not FP' {
    run_embedded_test 'tests/unit/test_gate_fp_relaxation_proposal.bats' 'escalated_to_block WARN is treated as TP, not FP' content_test_gate_fp_relaxation_proposal
}

@test 'test_gate_fp_relaxation_proposal.bats :: single WARN followed by CLEAR is still counted as FP' {
    run_embedded_test 'tests/unit/test_gate_fp_relaxation_proposal.bats' 'single WARN followed by CLEAR is still counted as FP' content_test_gate_fp_relaxation_proposal
}

@test 'test_gate_gunshi_startup_missed_sg.bats :: missed_sg Top3を集計表示する' {
    run_embedded_test 'tests/unit/test_gate_gunshi_startup_missed_sg.bats' 'missed_sg Top3を集計表示する' content_test_gate_gunshi_startup_missed_sg
